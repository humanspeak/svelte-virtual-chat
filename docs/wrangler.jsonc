{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "svelte-page-virtualchat",
    "compatibility_date": "2026-04-21",
    "compatibility_flags": ["nodejs_als", "nodejs_compat"],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "upload_source_maps": true,
    "vars": {
        "PUBLIC_ENVIRONMENT": "production",
        "ENVIRONMENT": "production",
        "NODE_ENV": "production",
        // checkov:skip=CKV_SECRET_6: PostHog project tokens are public client-side SDK identifiers.
        "PUBLIC_POSTHOG_PROJECT_TOKEN": "phc_omqFJJbUcmgSYXDUCsijUPZ7xxcMnM4F9QrFZ6cuscCc",
        "PUBLIC_POSTHOG_HOST": "https://j.svelte.page"
    }
}
